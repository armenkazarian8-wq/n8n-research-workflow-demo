{
  "name": "n8n-research-workflow-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Demo n8n + Gemini research & content workflow with HTML dashboard",
  "scripts": {
    "pipeline": "node scripts/run-pipeline.js",
    "dashboard": "npx --yes serve dashboard -l 8765",
    "n8n": "echo \"Requires Node.js 18-22. Example: N8N_USER_FOLDER=./.n8n N8N_BLOCK_ENV_ACCESS_IN_NODE=false npx n8n@1.72.1\"",
    "test": "node scripts/run-pipeline.js",
    "n8n:import": "node -e \"const fs=require(\"fs\");const w=JSON.parse(fs.readFileSync(\"workflow/research-content-workflow.json\"));fs.writeFileSync(\"/tmp/wf.json\",JSON.stringify([w]));\" && N8N_BLOCK_ENV_ACCESS_IN_NODE=false n8n import:workflow --input=/tmp/wf.json",
    "n8n:execute": "N8N_BLOCK_ENV_ACCESS_IN_NODE=false NODE_FUNCTION_ALLOW_BUILTIN=fs n8n execute --id=research-content-demo"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
